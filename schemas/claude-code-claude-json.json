{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xsyetopz.github.io/claude-code-docs/schemas/claude-code-claude-json.json",
  "title": "Claude Code ~/.claude.json (Claude Code 2.1.308)",
  "$comment": "For ~/.claude.json (the global state file). Generated from Claude Code 2.1.308 by tools/schemas/code.ts. Anchors: the defaults function (first key numStartups:0), the per-project defaults object (allowedTools:[],mcpContextUris:[],mcpServers:{}) used as the fallback for projects[<path>], and the list of user-settable keys (starts \"apiKeyHelper\",\"installMethod\",\"autoUpdates\"). \"default\" is the value in the code's defaults; \"x-user-settable\" marks keys in that list. Keys with no default value in the code (undefined, or only in the list) are x-unverified. The file holds more keys than these (the program writes others on demand); only keys the code names are listed. No probe in captures/ records this file's keys, so nothing is marked x-observed. Do not edit by hand.",
  "type": "object",
  "properties": {
    "numStartups": {
      "type": "number",
      "default": 0
    },
    "installMethod": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "autoUpdates": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "theme": {
      "type": "string",
      "default": "dark",
      "x-user-settable": true
    },
    "preferredNotifChannel": {
      "type": "string",
      "default": "auto",
      "x-user-settable": true
    },
    "verbose": {
      "type": "boolean",
      "default": false,
      "x-user-settable": true
    },
    "editorMode": {
      "type": "string",
      "default": "normal",
      "x-user-settable": true
    },
    "autoCompactEnabled": {
      "type": "boolean",
      "default": true,
      "x-user-settable": true
    },
    "autoScrollEnabled": {
      "type": "boolean",
      "default": true,
      "x-user-settable": true
    },
    "showTurnDuration": {
      "type": "boolean",
      "default": true,
      "x-user-settable": true
    },
    "externalEditorContext": {
      "type": "boolean",
      "default": false,
      "x-user-settable": true
    },
    "showMessageTimestamps": {
      "type": "boolean",
      "default": false,
      "x-user-settable": true
    },
    "hasSeenTasksHint": {
      "type": "boolean",
      "default": false
    },
    "hasUsedStash": {
      "type": "boolean",
      "default": false
    },
    "hasUsedBackgroundTask": {
      "type": "boolean",
      "default": false
    },
    "queuedCommandUpHintCount": {
      "type": "number",
      "default": 0
    },
    "diffTool": {
      "type": "string",
      "default": "auto",
      "x-user-settable": true
    },
    "customApiKeyResponses": {
      "type": "object",
      "properties": {
        "approved": {
          "type": "array"
        },
        "rejected": {
          "type": "array"
        }
      }
    },
    "env": {
      "type": "object",
      "properties": {},
      "x-user-settable": true
    },
    "tipsHistory": {
      "type": "object",
      "properties": {},
      "x-user-settable": true
    },
    "memoryUsageCount": {
      "type": "number",
      "default": 0
    },
    "promptQueueUseCount": {
      "type": "number",
      "default": 0
    },
    "btwUseCount": {
      "type": "number",
      "default": 0
    },
    "todoFeatureEnabled": {
      "type": "boolean",
      "default": true,
      "x-user-settable": true
    },
    "showExpandedTodos": {
      "type": "boolean",
      "default": false,
      "x-user-settable": true
    },
    "briefTranscript": {
      "type": "boolean",
      "default": false,
      "x-user-settable": true
    },
    "messageIdleNotifThresholdMs": {
      "type": "number",
      "default": 60000,
      "x-user-settable": true
    },
    "autoConnectIde": {
      "type": "boolean",
      "default": false,
      "x-user-settable": true
    },
    "autoInstallIdeExtension": {
      "type": "boolean",
      "default": true,
      "x-user-settable": true
    },
    "fileCheckpointingEnabled": {
      "type": "boolean",
      "default": true,
      "x-user-settable": true
    },
    "terminalProgressBarEnabled": {
      "type": "boolean",
      "default": true,
      "x-user-settable": true
    },
    "cachedDynamicConfigs": {
      "type": "object",
      "properties": {}
    },
    "cachedGrowthBookFeatures": {
      "type": "object",
      "properties": {}
    },
    "respectGitignore": {
      "type": "boolean",
      "default": true,
      "x-user-settable": true
    },
    "copyFullResponse": {
      "type": "boolean",
      "default": false,
      "x-user-settable": true
    },
    "apiKeyHelper": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "autoUpdatesProtectedForNative": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "shiftEnterKeyBindingInstalled": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "hasUsedBackslashReturn": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "diffSidebarOpen": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "showStatusInTerminalTab": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "taskCompleteNotifEnabled": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "inputNeededNotifEnabled": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "agentPushNotifEnabled": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "claudeInChromeDefaultEnabled": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "hasCompletedClaudeInChromeOnboarding": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "lspRecommendationDisabled": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "lspRecommendationNeverPlugins": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "lspRecommendationIgnoredCount": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "copyOnSelect": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "leftArrowOpensAgents": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "defaultToAgentsView": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "prStatusFooterEnabled": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "remoteControlAtStartup": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "autoUploadSessions": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "autoAddRemoteControlDaemonWorker": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "remoteDialogSeen": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "workflowSizeGuideline": {
      "x-unverified": true,
      "x-user-settable": true
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "properties": {
        "allowedTools": {
          "type": "array"
        },
        "mcpContextUris": {
          "type": "array"
        },
        "mcpServers": {
          "type": "object",
          "properties": {}
        },
        "enabledMcpjsonServers": {
          "type": "array"
        },
        "disabledMcpjsonServers": {
          "type": "array"
        },
        "hasTrustDialogAccepted": {
          "type": "boolean",
          "default": false
        },
        "hasClaudeMdExternalIncludesApproved": {
          "type": "boolean",
          "default": false
        },
        "hasClaudeMdExternalIncludesWarningShown": {
          "type": "boolean",
          "default": false
        }
      },
      "$comment": "Value of projects[<absolute path>]."
    }
  }
}
