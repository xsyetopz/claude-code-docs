  "properties": {
    "$schema": {
      "description": "JSON Schema URL for editor validation",
      "type": "string"
    },
    "$docs": {
      "description": "Documentation URL",
      "type": "string"
    },
    "bindings": {
      "type": "array",
      "items": {
