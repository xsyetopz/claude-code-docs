{
  "name": "claude-code-docs",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "lint": "markdownlint-cli2 \"docs/**/*.{md,mdx}\"",
    "check:docs": "bun tools/check-docs.ts",
    "check:examples": "bun tools/check-examples.ts",
    "llms:check": "bun tools/llms/check.ts",
    "schemas": "bun tools/schemas/generate.ts",
    "schemas:check": "bun tools/schemas/check.ts",
    "format": "biome format --write .",
    "lint:code": "biome check --formatter-enabled=false --error-on-warnings .",
    "commitlint": "commitlint",
    "prepare": "sh tools/install-hooks.sh",
    "verify": "bun run typecheck && bun run format:check && bun run lint:code && bun run lint && bun run check:docs && bun run check:examples && bun run schemas:check && bun run build && bun run llms:check && bun run plugin:check",
    "verify:locked": "sh tools/build-locked.sh",
    "typecheck": "bun --check",
    "format:check": "biome format .",
    "plugin:build": "bun build plugin/mcp/src/server.ts --target=bun --outfile=plugin/mcp/dist/server.js",
    "plugin:check": "bun tools/plugin/check.ts",
    "plugin:smoke": "bun tools/plugin/smoke.ts"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@mermaid-js/layout-elk": "^1.0.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/theme-classic": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.23.3",
    "typescript": "^7.0.2"
  }
}
