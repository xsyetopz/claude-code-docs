// plugin/mcp/src/cache.ts
import { createHash } from "crypto";
import {
  mkdirSync,
  readdirSync,
  readFileSync,
  renameSync,
  rmSync,
  statSync,
  writeFileSync
} from "fs";
import { homedir } from "os";
import { dirname, join, resolve, sep } from "path";
var CACHE_CAP_BYTES = 60 * 1024 * 1024;
var capBytes = () => {
  const n = Number(process.env["CC_DOCS_CACHE_CAP_BYTES"]);
  return process.env["CC_DOCS_CACHE_CAP_BYTES"] !== undefined && Number.isFinite(n) && n >= 0 ? n : CACHE_CAP_BYTES;
};
var cacheRoot = () => {
  const env = process.env;
  if (env["CC_DOCS_CACHE_DIR"])
    return resolve(env["CC_DOCS_CACHE_DIR"]);
  if (env["CLAUDE_PLUGIN_DATA"])
    return resolve(env["CLAUDE_PLUGIN_DATA"], "cache");
  return join(env["XDG_CACHE_HOME"] || join(homedir(), ".cache"), "claude-code-docs");
};
var inside = (base, ...parts) => {
  const root = resolve(base);
  const p = resolve(root, ...parts);
  return p.startsWith(root + sep) ? p : undefined;
};
var sha = (b) => createHash("sha256").update(b).digest("hex");
var isMeta = (m) => {
  if (typeof m !== "object" || m === null)
    return false;
  const o = m;
  return typeof o["url"] === "string" && typeof o["fetchedAt"] === "string" && typeof o["bytes"] === "number" && typeof o["sha256"] === "string";
};
var pruneRank = (relPath) => {
  const rel = relPath.replaceAll("\\", "/");
  if (rel.startsWith("platform/pages/"))
    return 0;
  if (rel.startsWith("site/pages/") || rel.startsWith("site/schemas/"))
    return 1;
  return 2;
};

class DiskCache {
  root;
  memory;
  approx;
  constructor(root = cacheRoot()) {
    this.root = root;
    try {
      mkdirSync(root, { recursive: true });
      const probe = join(root, `.probe.${process.pid}`);
      writeFileSync(probe, "");
      rmSync(probe);
    } catch {
      this.memory = new Map;
    }
  }
  file(rel) {
    return inside(this.root, rel);
  }
  get(rel) {
    if (this.memory)
      return this.memory.get(rel);
    const file = this.file(rel);
    if (!file)
      return;
    let buf;
    try {
      buf = readFileSync(file);
    } catch {
      return;
    }
    let meta;
    try {
      const m = JSON.parse(readFileSync(`${file}.meta.json`, "utf8"));
      if (!isMeta(m))
        throw new Error("bad meta");
      meta = m;
    } catch {
      meta = undefined;
    }
    if (meta && (buf.length !== meta.bytes || sha(buf) !== meta.sha256)) {
      this.delete(rel);
      return;
    }
    return { body: buf.toString("utf8"), meta };
  }
  put(rel, body, v) {
    const buf = Buffer.from(body, "utf8");
    const meta = {
      url: v.url,
      ...v.etag ? { etag: v.etag } : {},
      ...v.lastModified ? { lastModified: v.lastModified } : {},
      fetchedAt: new Date().toISOString(),
      status: 200,
      bytes: buf.length,
      sha256: sha(buf)
    };
    if (this.memory) {
      this.memory.set(rel, { body, meta });
      this.pruneMemory(rel);
      return;
    }
    const file = this.file(rel);
    if (!file)
      return;
    try {
      let before = 0;
      try {
        before = statSync(file).size;
      } catch {}
      this.atomic(file, buf);
      this.atomic(`${file}.meta.json`, JSON.stringify(meta));
      if (this.approx === undefined)
        this.approx = this.total();
      else
        this.approx += buf.length - before;
      if (this.approx > capBytes())
        this.prune(rel);
    } catch {}
  }
  touch(rel) {
    const c = this.get(rel);
    if (!c?.meta)
      return;
    const meta = { ...c.meta, fetchedAt: new Date().toISOString() };
    if (this.memory) {
      this.memory.set(rel, { body: c.body, meta });
      return;
    }
    const file = this.file(rel);
    if (!file)
      return;
    try {
      this.atomic(`${file}.meta.json`, JSON.stringify(meta));
    } catch {}
  }
  delete(rel) {
    if (this.memory) {
      this.memory.delete(rel);
      return;
    }
    const file = this.file(rel);
    if (!file)
      return;
    try {
      rmSync(file, { force: true });
      rmSync(`${file}.meta.json`, { force: true });
    } catch {}
  }
  atomic(file, data) {
    mkdirSync(dirname(file), { recursive: true });
    const tmp = `${file}.${process.pid}.tmp`;
    try {
      writeFileSync(tmp, data);
      renameSync(tmp, file);
    } catch (e) {
      rmSync(tmp, { force: true });
      throw e;
    }
  }
  files() {
    const out = [];
    let names;
    try {
      names = readdirSync(this.root, { recursive: true });
    } catch {
      return out;
    }
    for (const rel of names) {
      if (rel.endsWith(".meta.json") || rel.endsWith(".tmp"))
        continue;
      try {
        const s = statSync(join(this.root, rel));
        if (!s.isFile())
          continue;
        let at = s.mtimeMs;
        try {
          at = Date.parse(JSON.parse(readFileSync(join(this.root, `${rel}.meta.json`), "utf8")).fetchedAt);
        } catch {}
        out.push({ rel, size: s.size, at });
      } catch {}
    }
    return out;
  }
  total() {
    return this.files().reduce((n, f) => n + f.size, 0);
  }
  pruneMemory(keep) {
    const mem = this.memory;
    if (!mem)
      return;
    const all = [...mem].map(([rel, c]) => ({
      rel,
      size: Buffer.byteLength(c.body),
      at: c.meta ? Date.parse(c.meta.fetchedAt) : 0
    }));
    let size = all.reduce((n, f) => n + f.size, 0);
    const victims = all.filter((f) => pruneRank(f.rel) < 2 && f.rel !== keep).sort((a, b) => pruneRank(a.rel) - pruneRank(b.rel) || a.at - b.at);
    for (const f of victims) {
      if (size <= capBytes())
        break;
      mem.delete(f.rel);
      size -= f.size;
    }
  }
  prune(keep) {
    const all = this.files();
    let size = all.reduce((n, f) => n + f.size, 0);
    const victims = all.filter((f) => pruneRank(f.rel) < 2 && f.rel !== keep).sort((a, b) => pruneRank(a.rel) - pruneRank(b.rel) || a.at - b.at);
    for (const f of victims) {
      if (size <= capBytes())
        break;
      this.delete(f.rel);
      size -= f.size;
    }
    this.approx = size;
  }
}

// plugin/mcp/src/fetcher.ts
var FETCH_TIMEOUT_MS = 8000;
var MAX_REDIRECTS = 3;
var MAX_CONCURRENT = 6;
var UA = `claude-code-docs-mcp/${package_default.version} (+https://github.com/xsyetopz/claude-code-docs)`;
var ACCEPT = "text/markdown, text/plain, application/json;q=0.9";
var MB = 1024 * 1024;
var ttlScale = () => {
  const n = Number(process.env["CC_DOCS_TTL_SCALE"]);
  return process.env["CC_DOCS_TTL_SCALE"] !== undefined && Number.isFinite(n) && n >= 0 ? n : 1;
};
var ttl = (ms) => ms * ttlScale();
var baseUrl = (envName, fallback) => {
  const raw = process.env[envName];
  if (!raw)
    return fallback;
  try {
    const u = new URL(raw);
    const local = u.hostname === "localhost" || u.hostname === "127.0.0.1";
    if (u.protocol === "https:" || u.protocol === "http:" && local)
      return raw.replace(/\/+$/, "");
  } catch {}
  console.error(`claude-code-docs: ignoring ${envName} (needs https)`);
  return fallback;
};
var cache;
var diskCache = () => {
  cache ??= new DiskCache;
  return cache;
};
var active = 0;
var waiting = [];
var acquire = async () => {
  if (active < MAX_CONCURRENT) {
    active++;
    return;
  }
  await new Promise((r) => waiting.push(r));
};
var release = () => {
  const next = waiting.shift();
  if (next)
    next();
  else
    active--;
};
var readCapped = async (res, max) => {
  const len = Number(res.headers.get("content-length"));
  if (Number.isFinite(len) && len > max) {
    await res.body?.cancel();
    return;
  }
  if (!res.body)
    return "";
  const chunks = [];
  let size = 0;
  const reader = res.body.getReader();
  for (;; ) {
    const { done, value } = await reader.read();
    if (done)
      break;
    size += value.length;
    if (size > max) {
      await reader.cancel();
      return;
    }
    chunks.push(value);
  }
  return Buffer.concat(chunks).toString("utf8");
};
var httpGet = async (url, maxBytes, validators) => {
  const origin = new URL(url).origin;
  const headers = {
    "User-Agent": UA,
    Accept: ACCEPT
  };
  if (validators.etag)
    headers["If-None-Match"] = validators.etag;
  else if (validators.lastModified)
    headers["If-Modified-Since"] = validators.lastModified;
  try {
    const signal = AbortSignal.timeout(FETCH_TIMEOUT_MS);
    let cur = url;
    for (let hop = 0;; hop++) {
      const res = await fetch(cur, { headers, signal, redirect: "manual" });
      if (res.status >= 300 && res.status < 400 && res.status !== 304) {
        await res.body?.cancel();
        const loc = res.headers.get("location");
        if (!loc)
          return { kind: "fail", message: "redirect without Location" };
        if (hop >= MAX_REDIRECTS)
          return { kind: "fail", message: "too many redirects" };
        const next = new URL(loc, cur);
        if (next.origin !== origin)
          return { kind: "fail", message: "redirect to another origin" };
        cur = next.href;
        continue;
      }
      if (res.status === 304) {
        await res.body?.cancel();
        return { kind: "not-modified" };
      }
      if (res.status === 404) {
        await res.body?.cancel();
        return { kind: "notfound" };
      }
      if (!res.ok) {
        await res.body?.cancel();
        return { kind: "fail", message: `HTTP ${res.status}` };
      }
      const body = await readCapped(res, maxBytes);
      if (body === undefined)
        return { kind: "fail", message: `response over ${maxBytes} bytes` };
      const etag = res.headers.get("etag");
      const lastModified = res.headers.get("last-modified");
      return {
        kind: "ok",
        body,
        ...etag ? { etag } : {},
        ...lastModified ? { lastModified } : {}
      };
    }
  } catch (e) {
    return {
      kind: "fail",
      message: e instanceof Error ? e.message : String(e)
    };
  }
};
var inflight = new Map;
var getResource = (spec) => {
  const key = `${spec.rel}
${spec.url}`;
  let p = inflight.get(key);
  if (!p) {
    p = resolveResource(spec).finally(() => inflight.delete(key));
    inflight.set(key, p);
  }
  return p;
};
var resolveResource = async (spec) => {
  const dc = diskCache();
  const origin = new URL(spec.url).host;
  let cached = dc.get(spec.rel);
  if (cached?.meta && cached.meta.url !== spec.url)
    cached = undefined;
  if (cached && spec.validate && !spec.validate(cached.body)) {
    dc.delete(spec.rel);
    cached = undefined;
  }
  const fetchedMs = cached?.meta ? Date.parse(cached.meta.fetchedAt) : NaN;
  if (cached?.meta && Date.now() - fetchedMs < spec.ttlMs) {
    return {
      status: "ok",
      body: cached.body,
      source: {
        origin,
        state: "cached",
        fetchedAt: cached.meta.fetchedAt,
        revalidated: false
      }
    };
  }
  await acquire();
  let got;
  try {
    got = await httpGet(spec.url, spec.maxBytes, {
      ...cached?.meta?.etag ? { etag: cached.meta.etag } : {},
      ...cached?.meta?.lastModified ? { lastModified: cached.meta.lastModified } : {}
    });
  } finally {
    release();
  }
  if (got.kind === "ok" && spec.validate && !spec.validate(got.body))
    got = { kind: "fail", message: "response is not valid" };
  if (got.kind === "notfound" && !spec.deleteOn404)
    got = { kind: "fail", message: "HTTP 404" };
  if (got.kind === "notfound") {
    if (spec.deleteOn404)
      dc.delete(spec.rel);
    return { status: "notfound", origin };
  }
  if (got.kind === "ok") {
    dc.put(spec.rel, got.body, {
      url: spec.url,
      ...got.etag ? { etag: got.etag } : {},
      ...got.lastModified ? { lastModified: got.lastModified } : {}
    });
    return {
      status: "ok",
      body: got.body,
      source: {
        origin,
        state: "live",
        fetchedAt: new Date().toISOString(),
        revalidated: false
      }
    };
  }
  if (got.kind === "not-modified" && cached) {
    dc.touch(spec.rel);
    return {
      status: "ok",
      body: cached.body,
      source: {
        origin,
        state: "cached",
        fetchedAt: new Date().toISOString(),
        revalidated: true
      }
    };
  }
  const message = got.kind === "fail" ? got.message : "unexpected 304 without a cached copy";
  if (cached) {
    return {
      status: "ok",
      body: cached.body,
      source: {
        origin,
        state: "stale-offline",
        fetchedAt: cached.meta?.fetchedAt ?? new Date(0).toISOString(),
        revalidated: false
      }
    };
  }
  return {
    status: "error",
    origin,
    message: `could not reach ${origin} and nothing is cached (${message})`
  };
};
var ago = (iso) => {
  const s = Math.max(0, (Date.now() - Date.parse(iso)) / 1000);
  if (s < 90)
    return `${Math.round(s)} s ago`;
  if (s < 5400)
    return `${Math.round(s / 60)} min ago`;
  if (s < 129600)
    return `${Math.round(s / 3600)} h ago`;
  return `${Math.round(s / 86400)} d ago`;
};
var sourceLine = (s) => {
  const what = s.state === "live" ? "live" : s.state === "stale-offline" ? `cache (fetched ${ago(s.fetchedAt)}, offline)` : s.revalidated ? "cache (revalidated, 304)" : `cache (fetched ${ago(s.fetchedAt)})`;
  return `Source: ${s.origin}, ${what}`;
};
var sourceData = (s) => ({
  origin: s.origin,
  state: s.state,
  fetchedAt: s.fetchedAt
});

// plugin/mcp/src/search.ts
var W_TITLE = 5;
var W_DESC = 3;
var W_HEAD = 3;
var W_EXTRA = 2;
var K1 = 1.4;
var B = 0.75;
var tokenize = (text) => {
  const out = [];
  for (const m of text.matchAll(/[A-Za-z0-9]+(?:[_.:-][A-Za-z0-9]+)*/g)) {
    const word = m[0];
    out.push(word.toLowerCase());
    const parts = word.split(/[_.:-]/).flatMap((p) => p.replace(/([a-z0-9])([A-Z])/g, "$1 $2").split(" "));
    if (parts.length > 1)
      for (const p of parts)
        out.push(p.toLowerCase());
  }
  return out;
};
var stripFrontMatter = (md) => md.replace(/^---\n[\s\S]*?\n---\n/, "");
var headingsOf = (md) => {
  const out = [];
  let fence = false;
  for (const line of md.split(`
`)) {
    if (/^```/.test(line))
      fence = !fence;
    const m = fence ? null : /^#{2,4}\s+(.*)$/.exec(line);
    if (m?.[1])
      out.push(m[1].trim());
  }
  return out;
};

class SearchIndex {
  docs = [];
  df = new Map;
  avg = 1;
  constructor(source) {
    for (const entry of source.entries()) {
      const raw = source.text(entry);
      if (raw === undefined)
        continue;
      const body = stripFrontMatter(raw);
      const tf = new Map;
      let len = 0;
      const add = (text, w) => {
        for (const t of tokenize(text)) {
          tf.set(t, (tf.get(t) ?? 0) + w);
          len += w;
        }
      };
      add(entry.title, W_TITLE);
      add(entry.description, W_DESC);
      add(headingsOf(body).join(`
`), W_HEAD);
      add(source.extra?.(entry) ?? "", W_EXTRA);
      add(body, 1);
      this.docs.push({ entry, body, tf, len });
      for (const t of tf.keys())
        this.df.set(t, (this.df.get(t) ?? 0) + 1);
    }
    this.avg = this.docs.reduce((s, d) => s + d.len, 0) / (this.docs.length || 1);
  }
  search(query, limit, section) {
    const terms = [...new Set(tokenize(query))];
    if (terms.length === 0)
      return [];
    const phrase = query.trim().toLowerCase();
    const n = this.docs.length;
    const hits = [];
    for (const d of this.docs) {
      if (section && !matchesSection(d.entry, section))
        continue;
      let score = 0;
      for (const t of terms) {
        const f = d.tf.get(t);
        if (!f)
          continue;
        const df = this.df.get(t) ?? 1;
        const idf = Math.log(1 + (n - df + 0.5) / (df + 0.5));
        score += idf * f * (K1 + 1) / (f + K1 * (1 - B + B * d.len / this.avg));
      }
      if (score === 0)
        continue;
      const lower = d.body.toLowerCase();
      if (phrase.length > 2 && lower.includes(phrase))
        score *= 1.5;
      if (d.entry.title.toLowerCase().includes(phrase))
        score *= 1.5;
      hits.push({ entry: d.entry, score, snippet: snippetOf(d.body, terms) });
    }
    return hits.sort((a, b) => b.score - a.score).slice(0, limit);
  }
}
var matchesSection = (e, section) => {
  const s = section.trim().toLowerCase().replace(/^\/+|\/+$/g, "");
  return e.section.toLowerCase() === s || e.route.toLowerCase().startsWith(`${s}/`) || e.route.toLowerCase().split("/")[0] === s;
};
var snippetOf = (body, terms) => {
  let heading = "";
  let best = { score: 0, line: "", heading: "" };
  let fence = false;
  for (const line of body.split(`
`)) {
    if (/^```/.test(line))
      fence = !fence;
    const h = !fence && /^#{1,4}\s+(.*)$/.exec(line);
    if (h) {
      heading = (h[1] ?? "").trim();
      continue;
    }
    if (!line.trim())
      continue;
    const toks = new Set(tokenize(line));
    let score = 0;
    for (const t of terms)
      if (toks.has(t))
        score++;
    if (score > best.score)
      best = { score, line: line.trim(), heading };
  }
  if (!best.line)
    return "";
  const line = best.line.length > 240 ? `${best.line.slice(0, 237)}...` : best.line;
  return best.heading ? `[${best.heading}] ${line}` : line;
};
var SEARCH_INDEX_MAX = 8 * 1024 * 1024;

// plugin/mcp/src/content.ts
var SITE = "https://xsyetopz.github.io/claude-code-docs";
var siteBase = () => baseUrl("CC_DOCS_BASE_URL", SITE);
var MANIFEST_TTL_MS = 10 * 60 * 1000;
var PAGE_TTL_MS = 60 * 60 * 1000;
var INDEX_TTL_MS = 60 * 60 * 1000;
var MANIFEST_MAX = 1 * MB;
var PAGE_MAX = 2 * MB;
var SCHEMA_MAX = 1 * MB;
var STALE_OFFLINE_MEM_TTL_MS = 60 * 1000;
var SCHEMA_NAMES = [
  "claude-code-settings",
  "claude-code-managed-settings",
  "claude-code-plugin-manifest",
  "claude-code-plugin-hooks",
  "claude-code-marketplace",
  "claude-code-keybindings",
  "claude-code-mcp",
  "claude-code-hook-output",
  "claude-code-tools",
  "claude-code-control-protocol",
  "claude-code-stream-json",
  "claude-code-agents-json",
  "claude-code-status-line",
  "claude-code-transcript",
  "claude-code-otel",
  "claude-code-frontmatter",
  "claude-code-claude-json"
];
var TYPE_FILE = "claude-code.d.ts";
var TYPE_NAMES = ["types", "claude-code", TYPE_FILE];
var normalizeRoute = (input) => {
  let r = input.trim();
  for (const o of new Set([siteBase(), SITE]))
    if (r === o || r.startsWith(`${o}/`)) {
      r = r.slice(o.length);
      break;
    }
  r = r.replace(/[?#].*$/, "").replace(/\.(md|html)$/, "");
  return r.replace(/^\/+|\/+$/g, "") || "index";
};
var ROUTE_RE = /^\/?[a-z0-9][a-z0-9/_-]*$/i;
var sanitizeManifest = (list, base = siteBase()) => {
  if (!Array.isArray(list))
    return [];
  const out = [];
  for (const raw of list) {
    if (!raw || typeof raw !== "object")
      continue;
    const { route, title, description, section, md, url } = raw;
    if (typeof route !== "string" || typeof title !== "string" || typeof description !== "string" || typeof section !== "string" || typeof url !== "string")
      continue;
    const okRoute = route === "/" || ROUTE_RE.test(route) && !route.includes("//") && !route.includes("..");
    if (!okRoute || !(url === base || url.startsWith(`${base}/`)))
      continue;
    out.push({
      route: normalizeRoute(route),
      title,
      description,
      section,
      md: typeof md === "string" ? md : "",
      url
    });
  }
  return out;
};
var parseManifest = (text) => {
  try {
    return sanitizeManifest(JSON.parse(text));
  } catch {
    return [];
  }
};
var parseSearchIndex = (text) => {
  try {
    const j = JSON.parse(text);
    if (typeof j !== "object" || j === null)
      return;
    const { hash, pages } = j;
    if (typeof hash !== "string" || !Array.isArray(pages))
      return;
    const out = [];
    for (const p of pages) {
      if (!p || typeof p !== "object")
        continue;
      const { route, title, description, headings, extra, body } = p;
      if (typeof route !== "string" || typeof title !== "string" || typeof description !== "string" || !Array.isArray(headings) || typeof extra !== "string" || typeof body !== "string")
        continue;
      out.push({
        route: normalizeRoute(route),
        title,
        description,
        headings: headings.filter((h) => typeof h === "string"),
        extra,
        body
      });
    }
    return out.length > 0 ? { hash, pages: out } : undefined;
  } catch {
    return;
  }
};

class ContentError extends Error {
}

class Content {
  mem;
  ver;
  verRetryAt = 0;
  version = 0;
  async manifest() {
    const m = this.mem;
    const memTtl = m?.source.state === "stale-offline" ? STALE_OFFLINE_MEM_TTL_MS : MANIFEST_TTL_MS;
    if (m && Date.now() - m.at < ttl(memTtl))
      return {
        entries: m.entries,
        source: {
          ...m.source,
          state: m.source.state === "live" ? "cached" : m.source.state
        }
      };
    const r = await getResource({
      url: `${siteBase()}/llms-manifest.json`,
      rel: "site/llms-manifest.json",
      ttlMs: ttl(MANIFEST_TTL_MS),
      maxBytes: MANIFEST_MAX,
      validate: (b) => parseManifest(b).length > 0
    });
    if (r.status !== "ok") {
      if (m)
        return {
          entries: m.entries,
          source: { ...m.source, state: "stale-offline" }
        };
      throw new ContentError(r.status === "error" ? r.message : `the page list was not found on ${r.origin}`);
    }
    const entries = parseManifest(r.body);
    const same = m && m.entries.length === entries.length && m.entries.every((e, i) => e.route === entries[i]?.route);
    if (!same)
      this.version++;
    this.mem = {
      entries,
      byRoute: new Map(entries.map((e) => [e.route, e])),
      source: r.source,
      at: Date.now()
    };
    return { entries, source: r.source };
  }
  async find(input) {
    await this.manifest();
    return this.mem?.byRoute.get(normalizeRoute(input));
  }
  searchIndex() {
    return getResource({
      url: `${siteBase()}/search-index.json`,
      rel: "site/search-index.json",
      deleteOn404: true,
      ttlMs: ttl(INDEX_TTL_MS),
      maxBytes: SEARCH_INDEX_MAX,
      validate: (b) => parseSearchIndex(b) !== undefined
    });
  }
  readPage(e) {
    return getResource({
      url: `${siteBase()}/${e.route}.md`,
      rel: `site/pages/${e.route}.md`,
      deleteOn404: true,
      ttlMs: ttl(PAGE_TTL_MS),
      maxBytes: PAGE_MAX
    });
  }
  async loadPages(entries) {
    const out = {
      texts: new Map,
      total: entries.length,
      offline: 0,
      fromCache: 0,
      oldest: undefined
    };
    await Promise.all(entries.map(async (e) => {
      const r = await this.readPage(e);
      if (r.status !== "ok")
        return;
      out.texts.set(e.route, r.body);
      if (r.source.state !== "live")
        out.fromCache++;
      if (r.source.state === "stale-offline")
        out.offline++;
      if (!out.oldest || r.source.fetchedAt < out.oldest)
        out.oldest = r.source.fetchedAt;
    }));
    return out;
  }
  async schema(name) {
    const n = name.replace(/\.json$/, "");
    const full = n.startsWith("claude-code-") ? n : `claude-code-${n}`;
    if (!SCHEMA_NAMES.includes(full))
      return "unknown";
    const r = await getResource({
      url: `${siteBase()}/schemas/${full}.json`,
      rel: `site/schemas/${full}.json`,
      deleteOn404: true,
      ttlMs: ttl(PAGE_TTL_MS),
      maxBytes: SCHEMA_MAX,
      validate: (b) => {
        try {
          const j = JSON.parse(b);
          return typeof j === "object" && j !== null && !Array.isArray(j);
        } catch {
          return false;
        }
      }
    });
    if (r.status !== "ok")
      return r;
    const schema = JSON.parse(r.body);
    this.ver ??= /\(Claude Code (\d+\.\d+\.\d+)\)/.exec(String(schema["title"]))?.[1];
    return {
      status: "ok",
      schema,
      source: r.source
    };
  }
  async typeFile() {
    return getResource({
      url: `${siteBase()}/schemas/${TYPE_FILE}`,
      rel: `site/schemas/${TYPE_FILE}`,
      deleteOn404: true,
      ttlMs: ttl(PAGE_TTL_MS),
      maxBytes: SCHEMA_MAX,
      validate: (b) => b.includes("declare module")
    });
  }
  async claudeCode() {
    if (this.ver)
      return this.ver;
    if (Date.now() < this.verRetryAt)
      return;
    const r = await getResource({
      url: `${siteBase()}/llms.txt`,
      rel: "site/llms.txt",
      ttlMs: ttl(MANIFEST_TTL_MS),
      maxBytes: PAGE_MAX
    });
    if (r.status !== "ok") {
      this.verRetryAt = Date.now() + ttl(MANIFEST_TTL_MS);
      return;
    }
    const head = r.body.split(`
`).slice(0, 6).join(`
`);
    this.ver = /Claude Code (\d+\.\d+\.\d+)/.exec(head)?.[1];
    return this.ver;
  }
}

// plugin/mcp/src/platform.ts
var PLATFORM = "https://platform.claude.com";
var platformBase = () => baseUrl("PLATFORM_DOCS_BASE_URL", PLATFORM);
var INDEX_TTL_MS2 = 10 * 60 * 1000;
var PAGE_TTL_MS2 = 6 * 60 * 60 * 1000;
var FILE_MAX = 2 * MB;
var PATH_RE = /^[a-z0-9][a-z0-9/_-]*$/;
var normalizePlatformPath = (input) => {
  let r = input.trim();
  if (/^[a-z][a-z0-9+.-]*:\/\//i.test(r) || r.startsWith("//")) {
    const hosts = new Set([platformBase(), PLATFORM]);
    const o = [...hosts].find((h) => r === h || r.startsWith(`${h}/`));
    if (!o)
      return;
    r = r.slice(o.length);
  }
  r = r.replace(/[?#].*$/, "").replace(/\.md$/, "");
  r = r.replace(/^\/+|\/+$/g, "");
  if (r === "docs" || r.startsWith("docs/")) {
    if (!r.startsWith("docs/en/"))
      return;
    r = r.slice("docs/en/".length);
  }
  if (!PATH_RE.test(r) || r.includes("//"))
    return;
  return r;
};
var parseLlmsTxt = (text, base = platformBase()) => {
  const hosts = [...new Set([base, PLATFORM])].map((h) => h.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|");
  const line = new RegExp(`^- \\[(.+?)\\]\\(((?:${hosts})/docs/en/[^)\\s]+?)\\.md\\)(?: - (.*))?$`);
  const out = [];
  let inEnglish = false;
  let group = "";
  for (const raw of text.split(/\r?\n/)) {
    const h2 = /^##\s+(.*?)\s*$/.exec(raw);
    if (h2 && !raw.startsWith("###")) {
      inEnglish = h2[1] === "English";
      group = "";
      continue;
    }
    if (!inEnglish)
      continue;
    const h3 = /^###\s+(.*?)\s*$/.exec(raw);
    if (h3) {
      group = h3[1] ?? "";
      continue;
    }
    const m = line.exec(raw);
    if (!m)
      continue;
    const path = normalizePlatformPath(`${m[2]}.md`);
    if (!path)
      continue;
    out.push({
      path,
      title: m[1] ?? path,
      description: m[3] ?? "",
      group,
      url: `${base}/docs/en/${path}`
    });
  }
  return out;
};
var asEntry = (p) => ({
  route: p.path,
  title: p.title,
  description: `${p.description} ${p.path.replace(/[/_-]+/g, " ")}`,
  section: p.group,
  md: "",
  url: p.url
});

class Platform {
  memo;
  async index() {
    const r = await getResource({
      url: `${platformBase()}/llms.txt`,
      rel: "platform/llms.txt",
      ttlMs: ttl(INDEX_TTL_MS2),
      maxBytes: FILE_MAX,
      validate: (b) => parseLlmsTxt(b).length > 0
    });
    if (r.status !== "ok")
      throw new ContentError(r.status === "error" ? `platform docs are offline and not cached yet: could not reach ${r.origin}` : `llms.txt was not found on ${r.origin}`);
    if (this.memo?.body !== r.body) {
      const entries = parseLlmsTxt(r.body);
      const asE = entries.map(asEntry);
      const idx = new SearchIndex({
        entries: () => asE,
        text: () => "",
        extra: (e) => e.section
      });
      this.memo = { body: r.body, entries, idx };
    }
    const { entries, idx } = this.memo;
    const byPath = new Map(entries.map((e) => [e.path, e]));
    return {
      entries,
      source: r.source,
      search(query, limit, group) {
        const want = group?.trim().toLowerCase();
        return idx.search(query, entries.length).filter((h) => !want || h.entry.section.toLowerCase() === want).slice(0, limit).flatMap((h) => {
          const entry = byPath.get(h.entry.route);
          return entry ? [
            {
              entry,
              score: h.score,
              snippet: entry.description || entry.title
            }
          ] : [];
        });
      }
    };
  }
  known() {
    return this.memo?.entries;
  }
  readPage(path) {
    return getResource({
      url: `${platformBase()}/docs/en/${path}.md`,
      rel: `platform/pages/${path}.md`,
      deleteOn404: true,
      ttlMs: ttl(PAGE_TTL_MS2),
      maxBytes: FILE_MAX
    });
  }
}
var nearPlatform = (path, entries) => {
  const want = new Set(tokenize(path.replace(/[/_-]+/g, " ")));
  const near = entries.map((e) => ({
    e,
    n: tokenize(`${e.path.replace(/[/_-]+/g, " ")} ${e.title}`).filter((t) => want.has(t)).length
  })).filter((x) => x.n > 0 && x.e.path !== path).sort((a, b) => b.n - a.n).slice(0, 5).map((x) => `  - ${x.e.path}`).join(`
`);
  return near ? `
Closest matches:
${near}` : "";
};

// plugin/mcp/src/types.ts
var HEAD = /^(\s*)(?:export )?(?:declare )?(?:type|interface|function|const|class|namespace) ([\w$]+)/;
var MODULE = /^declare module '([^']+)' \{/;
var code = (line, inDoc) => {
  let out = "";
  let i = 0;
  let doc = inDoc;
  while (i < line.length) {
    if (doc) {
      const close = line.indexOf("*/", i);
      if (close < 0)
        return { text: out, inDoc: true };
      i = close + 2;
      doc = false;
    } else if (line.startsWith("/*", i)) {
      doc = true;
      i += 2;
    } else if (line.startsWith("//", i))
      break;
    else if (line[i] === "'" || line[i] === '"' || line[i] === "`") {
      const q = line[i];
      i++;
      while (i < line.length && line[i] !== q)
        i += line[i] === "\\" ? 2 : 1;
      i++;
      out += "''";
    } else
      out += line[i++];
  }
  return { text: out, inDoc: doc };
};
var blockEnd = (lines, start) => {
  let depth = 0;
  let inDoc = false;
  for (let i = start;i < lines.length; i++) {
    const c = code(lines[i] ?? "", inDoc);
    inDoc = c.inDoc;
    for (const ch of c.text) {
      if ("{[(".includes(ch))
        depth++;
      else if ("}])".includes(ch))
        depth--;
    }
    const t = c.text.trim();
    if (depth <= 0 && !inDoc && /[;},]$/.test(t))
      return i;
    if (depth < 0)
      return i;
  }
  return lines.length - 1;
};
var docStart = (lines, line) => {
  let i = line - 1;
  if (!(lines[i] ?? "").trim().endsWith("*/"))
    return line;
  while (i >= 0 && !(lines[i] ?? "").trim().startsWith("/**"))
    i--;
  return i >= 0 ? i : line;
};
var declarations = (lines) => {
  const out = [];
  let module = "";
  let inDoc = false;
  for (let i = 0;i < lines.length; i++) {
    const line = lines[i] ?? "";
    const m = MODULE.exec(line);
    if (m) {
      module = m[1] ?? "";
      continue;
    }
    const wasDoc = inDoc;
    inDoc = code(line, inDoc).inDoc;
    if (wasDoc)
      continue;
    const h = HEAD.exec(line);
    if (!h || (h[1] ?? "").length !== 2)
      continue;
    const end = blockEnd(lines, i);
    out.push({ name: h[2] ?? "", module, start: docStart(lines, i), end });
    i = end;
  }
  return out;
};
var member = (lines, from, to, name) => {
  const indent = (lines[from + 1] ?? "").match(/^\s*/)?.[0].length ?? 0;
  const n = name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const key = new RegExp(`^\\s{${indent}}(?:readonly )?(?:(['"])${n}\\1|${n})\\??\\s*[:(<]`);
  let inDoc = false;
  for (let i = from + 1;i < to; i++) {
    const line = lines[i] ?? "";
    const wasDoc = inDoc;
    inDoc = code(line, inDoc).inDoc;
    if (wasDoc || !key.test(line))
      continue;
    return { start: docStart(lines, i), end: blockEnd(lines, i) };
  }
  return;
};
var lookup = (src, query) => {
  const lines = src.split(`
`);
  const decls = declarations(lines);
  const slice = (a, b) => lines.slice(a, b + 1).join(`
`);
  const q = query.trim();
  const [head, ...rest] = q.startsWith("$.") ? ["EngineInterface", ...q.slice(2).split(".")] : q.split(".");
  const [mod, bare] = (head ?? "").includes(":") ? (head ?? "").split(":") : [undefined, head];
  const candidates = decls.filter((d) => d.name === bare && (mod === undefined || d.module === mod));
  if (q.startsWith("$."))
    candidates.push(...decls.filter((d) => d.name === "CoreEngineInterface"));
  for (const d of candidates) {
    let at = { start: d.start, end: d.end };
    let head = lineOfHead(lines, d);
    let ok = true;
    for (const part of rest) {
      const m = member(lines, head, at.end, part);
      if (!m) {
        ok = false;
        break;
      }
      at = m;
      head = lineOfHead(lines, m);
    }
    if (ok)
      return {
        kind: "text",
        title: `${d.module ? `${d.module}: ` : ""}${[d.name, ...rest].join(".")}`,
        text: slice(at.start, at.end)
      };
  }
  if (/^[a-z]+\.[\w.]+$|^classic\.\w+$/.test(q)) {
    const hits = [];
    for (const d of decls) {
      const m = member(lines, lineOfHead(lines, d), d.end, q);
      if (m)
        hits.push(`// ${d.name}['${q}']
${slice(m.start, m.end)}`);
    }
    if (hits.length)
      return { kind: "text", title: `event ${q}`, text: hits.join(`

`) };
  }
  const low = (bare ?? q).toLowerCase();
  const near = [...new Set(decls.map((d) => d.name))].filter((n) => n.toLowerCase().includes(low) || low.includes(n.toLowerCase())).slice(0, 20);
  return { kind: "missing", near };
};
var lineOfHead = (lines, d) => {
  let i = d.start;
  if ((lines[i] ?? "").trim().startsWith("/**"))
    while (i < d.end && !(lines[i] ?? "").trim().endsWith("*/"))
      i++;
  return (lines[i] ?? "").trim().endsWith("*/") ? i + 1 : i;
};
var outline = (src) => {
  const decls = declarations(src.split(`
`));
  const by = new Map;
  for (const d of decls)
    by.set(d.module, [...by.get(d.module) ?? [], d.name]);
  const parts = [...by].map(([m, names]) => `${m || "(global)"} (${names.length}): ${names.join(", ")}`);
  return `${decls.length} declarations. Pass \`property\`: a name ("ToolCheckResult"), a member path ("ToolCheckResult.plugin"), a call ("$.tool.check"), or an event ("tool.check").

${parts.join(`

`)}`;
};

// plugin/mcp/src/core.ts
var DEFAULT_PAGE_CHARS = 20000;
var content = new Content;
var platform = new Platform;
var INDEX_TTL_MS3 = 60 * 60 * 1000;
var PARTIAL_INDEX_TTL_MS = 60 * 1000;
var ok = (text, data, source, complete = false) => ({ ok: true, text, data, source, complete });
var fail = (text, source) => ({
  ok: false,
  text,
  data: { error: text },
  source,
  complete: false
});
var guarded = async (f) => {
  try {
    return await f();
  } catch (e) {
    if (e instanceof ContentError)
      return fail(e.message);
    throw e;
  }
};
var heading = async () => {
  const v = await content.claudeCode();
  return v ? `Claude Code Docs (Claude Code ${v})

` : "";
};
var index;
var building;
var buildIndex = () => {
  building ??= (async () => {
    const builtFor = content.version;
    const { entries, source } = await content.manifest();
    const got = await content.searchIndex();
    const parsed = got.status === "ok" ? parseSearchIndex(got.body) : undefined;
    if (got.status === "ok" && parsed) {
      if (index?.hash === parsed.hash && index.builtFor === builtFor) {
        index = { ...index, at: Date.now(), source: got.source };
        return index;
      }
      const byRoute = new Map(parsed.pages.map((p) => [p.route, p]));
      const have = entries.filter((e) => byRoute.has(e.route));
      const idx = new SearchIndex({
        entries: () => have,
        text: (e) => byRoute.get(e.route)?.body,
        extra: (e) => byRoute.get(e.route)?.extra
      });
      index = {
        builtFor,
        at: Date.now(),
        idx,
        source: got.source,
        pages: have.length,
        hash: parsed.hash
      };
      return index;
    }
    const load = await content.loadPages(entries);
    const idx = new SearchIndex({
      entries: () => entries,
      text: (e) => load.texts.get(e.route)
    });
    index = {
      builtFor,
      at: Date.now(),
      idx,
      source,
      pages: load.texts.size,
      load,
      fallback: got.status === "notfound" ? "no search-index.json on the site" : "search-index.json not available"
    };
    return index;
  })().finally(() => {
    building = undefined;
  });
  return building;
};
var searchIndex = async () => {
  await content.manifest();
  if (!index || index.builtFor !== content.version)
    return await buildIndex();
  const partial = index.load !== undefined && index.pages < index.load.total;
  if (Date.now() - index.at > ttl(partial ? PARTIAL_INDEX_TTL_MS : INDEX_TTL_MS3))
    buildIndex().catch(() => {});
  return index;
};
var indexSource = (b) => {
  const { load } = b;
  if (!load)
    return {
      ...b.source,
      state: b.source.state === "live" && Date.now() - b.at >= 60000 ? "cached" : b.source.state
    };
  return {
    origin: b.source.origin,
    state: load.offline > 0 ? "stale-offline" : load.fromCache < load.texts.size && Date.now() - b.at < 60000 ? "live" : "cached",
    fetchedAt: load.oldest ?? b.source.fetchedAt,
    revalidated: false
  };
};
var indexLine = (b) => {
  const { load } = b;
  if (!load)
    return `${sourceLine(indexSource(b))}, search index of ${b.pages} pages`;
  const cover = b.pages < load.total ? ` (${b.pages} of ${load.total} pages)` : "";
  return `Source: ${b.source.origin}, index built from ${b.pages} pages${cover}, ${load.fromCache} from cache${load.offline > 0 ? " (offline)" : ""}; ${b.fallback}`;
};
var searchPlatform = async ({
  query,
  limit = 8,
  section
}) => {
  const ix = await platform.index();
  const hits = ix.search(query, limit, section).map((h) => ({
    route: h.entry.path,
    title: h.entry.title,
    url: h.entry.url,
    section: h.entry.group,
    score: Math.round(h.score * 100) / 100,
    snippet: h.snippet
  }));
  const line = sourceLine(ix.source);
  const src = { ...sourceData(ix.source), line };
  if (hits.length === 0)
    return ok(`No platform pages match "${query}"${section ? ` in group "${section}"` : ""}. Try fewer or different keywords, drop the group filter, or browse the page list.

${line}`, { query, hits, source: src }, ix.source);
  const md = hits.map((h, i) => `${i + 1}. **${h.title}** (route \`${h.route}\`)
   ${h.url}${h.snippet ? `
   ${h.snippet}` : ""}`).join(`
`);
  return ok(`${hits.length} hit(s) for "${query}":

${md}

${line}`, { query, hits, source: src }, ix.source, true);
};
var search = (args) => guarded(async () => {
  if (args.source === "platform")
    return await searchPlatform(args);
  const { query, limit = 8, section } = args;
  const b = await searchIndex();
  const hits = b.idx.search(query, limit, section).map((h) => ({
    route: h.entry.route,
    title: h.entry.title,
    url: h.entry.url,
    section: h.entry.section,
    score: Math.round(h.score * 100) / 100,
    snippet: h.snippet
  }));
  const head = await heading();
  const line = indexLine(b);
  const src = indexSource(b);
  const version = await content.claudeCode();
  const data = {
    ...version ? { claudeCode: version } : {},
    query,
    hits,
    source: { ...sourceData(src), line }
  };
  if (hits.length === 0)
    return ok(`${head}No pages match "${query}"${section ? ` in section "${section}"` : ""}. Try fewer or different keywords, drop the section filter, or browse the page list.

${line}`, data, src);
  const md = hits.map((h, i) => `${i + 1}. **${h.title}** (route \`${h.route}\`)
   ${h.url}
   ${h.snippet}`).join(`
`);
  return ok(`${head}${hits.length} hit(s) for "${query}":

${md}

${line}`, data, src, true);
});
var sectionOf = (md, want0) => {
  const want = want0.trim().toLowerCase().replace(/^#+\s*/, "");
  const lines = md.split(`
`);
  const h2 = [];
  let fence = false;
  lines.forEach((line, at) => {
    if (/^```/.test(line))
      fence = !fence;
    const m = !fence && /^##\s+(.*)$/.exec(line);
    if (m)
      h2.push({ at, title: (m[1] ?? "").trim().toLowerCase() });
  });
  const i = h2.findIndex((h) => h.title === want);
  const k = i >= 0 ? i : h2.findIndex((h) => want.length > 2 && h.title.includes(want));
  const from = h2[k];
  if (!from)
    return;
  const to = h2[k + 1]?.at ?? lines.length;
  return lines.slice(from.at, to).join(`
`);
};
var nearList = (route, entries) => {
  const want = new Set(tokenize(route.replace(/[/_-]+/g, " ")));
  const near = entries.map((e) => ({
    e,
    n: tokenize(`${e.route.replace(/[/_-]+/g, " ")} ${e.title}`).filter((t) => want.has(t)).length
  })).filter((x) => x.n > 0 && x.e.route !== route).sort((a, b) => b.n - a.n).slice(0, 5).map((x) => `  - ${x.e.route}`).join(`
`);
  return near ? `
Closest matches:
${near}` : "";
};
var pageResult = (info, md0, heading, offset, maxChars, source) => {
  let md = md0;
  if (heading) {
    const sec = sectionOf(md, heading);
    if (sec === undefined) {
      const hs = headingsOf(md).map((h) => `  - ${h}`).join(`
`);
      return fail(`No H2 section "${heading}" on "${info.route}". Headings:
${hs}`, source);
    }
    md = sec;
  }
  const total = md.length;
  if (offset >= total && total > 0)
    return fail(`offset ${offset} is past the end (${total} characters).`, source);
  const chunk = md.slice(offset, offset + maxChars);
  const end = offset + chunk.length;
  const head = `${info.title} | ${info.url} | chars ${offset}-${end} of ${total}${end < total ? ` | more: call again with offset=${end}` : ""}`;
  return ok(`${head}

${chunk}

${sourceLine(source)}`, {
    ...info,
    offset,
    end,
    total,
    ...end < total ? { nextOffset: end } : {},
    text: chunk,
    source: sourceData(source)
  }, source);
};
var readPlatform = async ({
  route: input,
  heading,
  offset = 0,
  maxChars = DEFAULT_PAGE_CHARS
}) => {
  const path = normalizePlatformPath(input);
  if (!path)
    return fail(`Invalid path "${input}". Use a path under docs/en/ such as "build-with-claude/overview" (letters, digits, "-", "_" and "/" only; English pages on ${platformBase()} only).`);
  const r = await platform.readPage(path);
  if (r.status === "notfound") {
    const near = await platform.index().then((ix) => nearPlatform(path, ix.entries)).catch(() => "");
    return fail(`No platform page "${path}" on ${r.origin}; any cached copy was removed.${near}`);
  }
  if (r.status === "error")
    return fail(r.message);
  const known = platform.known()?.find((e) => e.path === path);
  const title = known?.title ?? /^title:\s*(.+)$/m.exec(r.body.slice(0, 1000))?.[1]?.trim() ?? path;
  const url = `${platformBase()}/docs/en/${path}`;
  return pageResult({ route: path, title, url }, r.body, heading, offset, maxChars, r.source);
};
var read = (args) => guarded(async () => {
  if (args.source === "platform")
    return await readPlatform(args);
  const { route, heading, offset = 0, maxChars = DEFAULT_PAGE_CHARS } = args;
  const entry = await content.find(route);
  if (!entry)
    return fail(`No page with route "${normalizeRoute(route)}". Routes look like "configure/status-line" (list the pages to see them).${nearList(normalizeRoute(route), (await content.manifest()).entries)}`);
  const r = await content.readPage(entry);
  if (r.status === "notfound")
    return fail(`Page "${entry.route}" is listed but no longer exists on ${r.origin}; any cached copy was removed.${nearList(entry.route, (await content.manifest()).entries)}`);
  if (r.status === "error")
    return fail(r.message);
  return pageResult({ route: entry.route, title: entry.title, url: entry.url }, r.body, heading, offset, maxChars, r.source);
});
var listPlatform = async ({ section }) => {
  const { entries, source } = await platform.index();
  const line = sourceLine(source);
  const src = sourceData(source);
  const groups = new Map;
  for (const e of entries)
    groups.set(e.group, (groups.get(e.group) ?? 0) + 1);
  if (!section) {
    const rows = [...groups].map(([g, n]) => `- ${g || "(none)"}: ${n}`);
    return ok(`${entries.length} page(s) in ${groups.size} group(s). Pass a group to list its pages:

${rows.join(`
`)}

${line}`, {
      groups: [...groups].map(([group, count]) => ({ group, count })),
      source: src
    }, source, true);
  }
  const want = section.trim().toLowerCase();
  const list = entries.filter((e) => e.group.toLowerCase() === want);
  if (list.length === 0)
    return fail(`No group "${section}". Groups: ${[...groups.keys()].join(", ")}`);
  const rows = list.map((e) => `- \`${e.path}\`: ${e.title}${e.description ? `. ${e.description}` : ""}`);
  return ok(`${list.length} page(s) in "${list[0]?.group}":

${rows.join(`
`)}

${line}`, {
    pages: list.map(({ path, title, group, description }) => ({
      route: path,
      title,
      section: group,
      description
    })),
    source: src
  }, source, true);
};
var list = (args = {}) => guarded(async () => {
  if (args.source === "platform")
    return await listPlatform(args);
  const { section } = args;
  const { entries: all, source } = await content.manifest();
  const pages = section ? all.filter((e) => matchesSection(e, section)) : all;
  if (pages.length === 0) {
    const secs = [...new Set(all.map((e) => e.section))].join(", ");
    return fail(`No pages in section "${section}". Sections: ${secs}`);
  }
  const lines = [];
  let current = "";
  for (const e of pages) {
    if (e.section !== current) {
      current = e.section;
      lines.push(`
## ${current}`);
    }
    lines.push(section ? `- \`${e.route}\`: ${e.title}. ${e.description}` : `- \`${e.route}\`: ${e.title}`);
  }
  const version = await content.claudeCode();
  return ok(`${await heading()}${pages.length} page(s):${lines.join(`
`)}

${sourceLine(source)}`, {
    ...version ? { claudeCode: version } : {},
    pages: pages.map(({ route, title, section: s, description }) => ({
      route,
      title,
      section: s,
      ...section ? { description } : {}
    })),
    source: sourceData(source)
  }, source, true);
});
var isObj = (v) => typeof v === "object" && v !== null && !Array.isArray(v);
var walk = (schema, path) => {
  let cur = schema;
  const keys = path.split(".").filter(Boolean);
  const defs = schema["$defs"];
  if (isObj(defs) && keys[0] && Object.hasOwn(defs, keys[0])) {
    const def = defs[keys.shift()];
    if (!isObj(def))
      return;
    cur = def;
  }
  for (const key of keys) {
    if (key === "__proto__" || key === "constructor" || key === "prototype")
      return;
    const props = cur["properties"];
    let next;
    if (isObj(props) && Object.hasOwn(props, key))
      next = props[key];
    else if (key === "[]")
      next = cur["items"];
    else
      next = cur["additionalProperties"] ?? cur["items"];
    if (!isObj(next))
      return;
    cur = next;
  }
  return cur;
};
var schemaPage = (name, property, out, offset, source) => {
  const LIMIT = 25000;
  if (offset >= out.length && out.length > 0)
    return fail(`offset ${offset} is past the end (${out.length} characters).`, source);
  const chunk = out.slice(offset, offset + LIMIT);
  const end = offset + chunk.length;
  const note = end < out.length ? `[chars ${offset}-${end} of ${out.length}; call again with offset=${end}]
` : "";
  return ok(`${note}${chunk}

${sourceLine(source)}`, {
    name,
    ...property ? { property } : {},
    offset,
    end,
    total: out.length,
    ...end < out.length ? { nextOffset: end } : {},
    text: chunk,
    source: sourceData(source)
  }, source);
};
var schema = (args) => guarded(async () => {
  const { name, property, offset = 0 } = args;
  if (TYPE_NAMES.includes(name)) {
    const got = await content.typeFile();
    if (got.status === "notfound")
      return fail(`The type file was not found on ${got.origin}.`);
    if (got.status === "error")
      return fail(got.message);
    if (!property)
      return schemaPage(name, property, outline(got.body), offset, got.source);
    const found = lookup(got.body, property);
    if (found.kind === "missing")
      return fail(`"${property}" is not in the type file, so its fields are unconfirmed for this release.${found.near.length ? ` Closest names in the file: ${found.near.join(", ")}. Look one of them up.` : " Call without `property` for the list of names."}`, got.source);
    return schemaPage(name, property, `// ${found.title}
${found.text}`, offset, got.source);
  }
  const got = await content.schema(name);
  if (got === "unknown")
    return fail(`Unknown schema "${name}". Valid names: ${SCHEMA_NAMES.join(", ")}, types`);
  if (got.status === "notfound")
    return fail(`Schema "${name}" was not found on ${got.origin}.`);
  if (got.status === "error")
    return fail(got.message);
  const { schema: sch, source } = got;
  let out;
  if (property) {
    const sub = walk(sch, property);
    if (!sub) {
      const keys = [
        ...Object.keys(sch["properties"] ?? {}),
        ...Object.keys(sch["$defs"] ?? {})
      ];
      return fail(`"${property}" is not in ${name}, so its fields are unconfirmed for this release. Its top-level properties and definitions: ${keys.join(", ")}. Look one of them up.`, source);
    }
    out = JSON.stringify(sub, null, 2);
  } else {
    const props = sch["properties"] ?? {};
    const rows = Object.entries(props).map(([k, v]) => {
      const type = Array.isArray(v["type"]) ? v["type"].join("|") : String(v["type"] ?? (v["anyOf"] ? "union" : "any"));
      const first = String(v["description"] ?? "").split(/(?<=\.)\s/)[0]?.slice(0, 140);
      return `- ${k} (${type})${first ? `: ${first}` : ""}`;
    });
    const defs = Object.keys(sch["$defs"] ?? {});
    const defList = defs.length ? `

${defs.length} definitions (pass one as \`property\`): ${defs.join(", ")}` : "";
    out = `${String(sch["title"])}
$id: ${String(sch["$id"])}
${rows.length} top-level properties. Pass \`property\` for details.

${rows.join(`
`)}${defList}`;
  }
  return schemaPage(name, property, out, offset, source);
});

// cli/src/cli.ts
var USAGE = `Usage: cc-docs <command> [options]

Commands:
  search <query>             Rank pages for keywords or an identifier
  read <route>               Print one page as markdown
  list [prefix]              List pages, or the pages of one section
  schema <name> [property]   Print a JSON Schema outline, one property, or a Mod API type

Options:
  --source docs|platform     docs (default): Claude Code Docs. platform: platform.claude.com/docs
  --section <heading>        read: print only the H2 section with this heading
  --limit <n>                search: most hits, 1 to 25 (default 8)
  --offset <n>               read, schema: character offset to continue a long output
  --json                     Print JSON in place of text
  --help                     Print this help (also: cc-docs <command> --help)

Each text output ends with a "Source:" line (live, cache, or offline cache).
Exit codes: 0 a result, 1 no result, 2 usage error.
`;
var COMMANDS = {
  search: `Usage: cc-docs search <query> [--source docs|platform] [--limit <n>] [--json]

Ranks pages for keywords or an identifier (cc-docs search PreToolUse).
Prints the route, title, URL, and a snippet for each hit.
The first search reads one prebuilt index file and caches it.
`,
  read: `Usage: cc-docs read <route> [--source docs|platform] [--section <heading>] [--offset <n>] [--json]

Prints one page as markdown. A route comes from search or list, for example configure/status-line.
--section prints only the H2 section with that heading.
A long page ends its header line with the offset for --offset.
`,
  list: `Usage: cc-docs list [prefix] [--source docs|platform] [--json]

Lists pages in sidebar order. A prefix is a top-level section (docs) or a group (platform), for example configure.
`,
  schema: `Usage: cc-docs schema <name> [property] [--offset <n>] [--json]

Prints the outline of a JSON Schema (settings, tools, hook-output, ...), one property of it (hooks.PreToolUse), or a definition (BashInput.command).
With the name types, prints names of the Mod API type file, or the type, member, call, or event that the property names.
`
};
var isCommand = (s) => s !== undefined && Object.hasOwn(COMMANDS, s);

class UsageError extends Error {
}
var parse = (argv) => {
  try {
    return parseArgs({
      args: argv,
      allowPositionals: true,
      options: {
        source: { type: "string" },
        section: { type: "string" },
        limit: { type: "string" },
        offset: { type: "string" },
        json: { type: "boolean" },
        help: { type: "boolean", short: "h" }
      }
    });
  } catch (e) {
    throw new UsageError(e instanceof Error ? e.message : String(e));
  }
};
var int = (name, v, min, max) => {
  if (v === undefined)
    return;
  const n = Number(v);
  if (!Number.isInteger(n) || n < min || n > max)
    throw new UsageError(`--${name} needs a whole number from ${min} to ${max}`);
  return n;
};
var run = async (argv) => {
  const { values, positionals } = parse(argv);
  const [command, ...args] = positionals;
  if (!command) {
    if (values.help) {
      process.stdout.write(USAGE);
      return 0;
    }
    throw new UsageError("missing command");
  }
  if (!isCommand(command))
    throw new UsageError(`unknown command "${command}"`);
  if (values.help) {
    process.stdout.write(COMMANDS[command]);
    return 0;
  }
  const only = (opt, ...on) => {
    if (values[opt] !== undefined && !on.includes(command))
      throw new UsageError(`--${opt} does not apply to ${command}`);
  };
  only("source", "search", "read", "list");
  only("section", "read");
  only("limit", "search");
  only("offset", "read", "schema");
  const source = values.source ?? "docs";
  if (source !== "docs" && source !== "platform")
    throw new UsageError(`--source needs docs or platform, not "${source}"`);
  const src = source;
  const need = (min, max, what) => {
    if (args.length < min || args.length > max)
      throw new UsageError(`${command} needs ${what}`);
  };
  let r;
  let empty = false;
  switch (command) {
    case "search": {
      need(1, Number.MAX_SAFE_INTEGER, "<query>");
      const limit = int("limit", values.limit, 1, 25);
      r = await search({
        query: args.join(" "),
        source: src,
        ...limit ? { limit } : {}
      });
      empty = r.ok && r.data["hits"].length === 0;
      break;
    }
    case "read": {
      need(1, 1, "<route>");
      const offset = int("offset", values.offset, 0, Number.MAX_SAFE_INTEGER);
      r = await read({
        route: args[0],
        source: src,
        ...values.section ? { heading: values.section } : {},
        ...offset ? { offset } : {}
      });
      break;
    }
    case "list":
      need(0, 1, "at most one [prefix]");
      r = await list({ source: src, ...args[0] ? { section: args[0] } : {} });
      break;
    case "schema": {
      need(1, 2, "<name> [property]");
      const offset = int("offset", values.offset, 0, Number.MAX_SAFE_INTEGER);
      r = await schema({
        name: args[0],
        ...args[1] ? { property: args[1] } : {},
        ...offset ? { offset } : {}
      });
      break;
    }
  }
  if (!r.ok || empty && !values.json) {
    process.stderr.write(`${r.text}
`);
    return 1;
  }
  if (values.json)
    process.stdout.write(`${JSON.stringify(r.data, null, 2)}
`);
  else
    process.stdout.write(`${r.text}
`);
  return empty ? 1 : 0;
};
try {
  process.exitCode = await run(process.argv.slice(2));
} catch (e) {
  if (!(e instanceof UsageError))
    throw e;
  process.stderr.write(`cc-docs: ${e.message}

${USAGE}`);
  process.exitCode = 2;
}
